{
  "name": "shotrn",
  "private": true,
  "version": "1.0.0",
  "description": "URL shortener: turn a long link into a short one that redirects to the original URL",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "vp lint . --max-warnings=0",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "vp check && npm run typecheck",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run db:migrate -w backend",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.0.0-rc.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vitest": "5.0.1"
  }
}
