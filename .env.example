# Copy to .env and fill in. Never commit .env (constitution III: secrets via env only).

DATABASE_URL=postgres://app:app@localhost:5432/shotrn
BASE_URL=http://localhost:3000
PORT=3000

RATE_LIMIT_CREATE_PER_HOUR=60
RATE_LIMIT_REDIRECT_PER_MINUTE=600
# Unknown short codes looked up per client (IPv4 address or IPv6 /64), redirect and
# preview combined. Once spent, every lookup is refused until the window ends.
RATE_LIMIT_UNKNOWN_CODE_PER_10_MINUTES=20
