# Copy to .env and fill in. Never commit .env (constitution III: secrets via env only).

DATABASE_URL=postgres://app:app@localhost:5432/shotrn
BASE_URL=http://localhost:3000
PORT=3000

# 62-character shuffle of [0-9A-Za-z]. Generate ONCE with:
#   node -e "const a=[...'0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}console.log(a.join(''))"
# WARNING: changing this after launch invalidates every short link ever issued.
SQIDS_ALPHABET=

RATE_LIMIT_CREATE_PER_HOUR=60
RATE_LIMIT_REDIRECT_PER_MINUTE=600
